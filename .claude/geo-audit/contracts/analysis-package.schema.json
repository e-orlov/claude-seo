{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/e-orlov/claude-seo/.claude/geo-audit/contracts/analysis-package.schema.json",
  "title": "Completed GEO analysis handoff package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_type", "schema_version", "run_id", "run_state", "created_at",
    "config_sha256", "contract", "policy", "source_manifest", "clustering",
    "factor_results", "evidence", "findings", "recommendations", "limitations",
    "completion_gate", "package_sha256"
  ],
  "properties": {
    "package_type": {"const": "geo_analysis_package"},
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^geo-[a-z0-9-]+-[0-9]{4}-[0-9]{2}-[0-9]{2}-r[1-9][0-9]*$"},
    "run_state": {"enum": ["ANALYSIS_COMPLETE", "ANALYSIS_COMPLETE_WITH_GAPS"]},
    "created_at": {"type": "string", "format": "date-time"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_catalog_version", "source_catalog_fingerprint", "factor_catalog_version", "factor_catalog_fingerprint"],
      "properties": {
        "source_catalog_version": {"const": "1.0.0"},
        "source_catalog_fingerprint": {"$ref": "#/$defs/sha256"},
        "factor_catalog_version": {"const": "1.0.0"},
        "factor_catalog_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "fingerprint"],
      "properties": {
        "version": {"const": "1.0.0"},
        "fingerprint": {"const": "77da1451409845f6ba53d97f90071c92a4b26cc248f8d6b2bbc5634aaebe89ed"}
      }
    },
    "source_manifest": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {"$ref": "#/$defs/sourceManifestEntry"}
    },
    "clustering": {"$ref": "#/$defs/clusteringResult"},
    "factor_results": {
      "type": "array",
      "minItems": 129,
      "maxItems": 129,
      "items": {"$ref": "#/$defs/factorResult"}
    },
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "recommendations": {"type": "array", "items": {"$ref": "#/$defs/recommendation"}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "completion_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "check_count", "failed_checks"],
      "properties": {
        "passed": {"const": true},
        "check_count": {"type": "integer", "minimum": 1},
        "failed_checks": {"type": "array", "maxItems": 0}
      }
    },
    "package_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "factorId": {"type": "string", "pattern": "^(T|B|C|S|O|M)[0-9]{2}$"},
    "evidenceId": {"type": "string", "pattern": "^E-[0-9]{4,}$"},
    "sourceCode": {"enum": ["SF", "RAW", "REN", "PSI", "GSC-SA", "GSC-UI", "GSC-GAI", "AH-BL", "AH-RD", "AH-BB", "SX-M", "SX-O", "SX-C", "SX-P", "SX-PC", "SX-S", "SX-SENT", "DJ"]},
    "sourceManifestEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_code", "source_level_status", "artifact_id", "artifact_sha256", "scope_status", "freshness_status", "record_count", "valid_empty", "limitations"],
      "properties": {
        "source_code": {"$ref": "#/$defs/sourceCode"},
        "source_level_status": {"const": "ready"},
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "scope_status": {"const": "match"},
        "freshness_status": {"enum": ["current", "stale", "unknown"]},
        "record_count": {"type": "integer", "minimum": 0},
        "valid_empty": {"type": "boolean"},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "clusteringResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster_run_id", "crawl_universe_sha256", "html_url_count", "vertical_row_count", "horizontal_row_count", "prefix_membership_count", "unresolved_count", "memberships_recomputed"],
      "properties": {
        "cluster_run_id": {"type": "string", "minLength": 1},
        "crawl_universe_sha256": {"$ref": "#/$defs/sha256"},
        "html_url_count": {"type": "integer", "minimum": 1},
        "vertical_row_count": {"type": "integer", "minimum": 1},
        "horizontal_row_count": {"type": "integer", "minimum": 1},
        "prefix_membership_count": {"type": "integer", "minimum": 1},
        "unresolved_count": {"const": 0},
        "memberships_recomputed": {"const": true}
      }
    },
    "factorResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factor_id", "applicability", "measurement_status", "scope_type", "coverage_rate", "metrics", "confidence", "evidence_ids", "recommendation_ids", "limitations"],
      "properties": {
        "factor_id": {"$ref": "#/$defs/factorId"},
        "applicability": {"enum": ["applicable", "not_applicable"]},
        "measurement_status": {"enum": ["measured", "partially_measured", "not_determined", "not_applicable", "source_error"]},
        "scope_type": {"enum": ["full", "representative_sample", "diagnostic_sample", "source_corpus", "snapshot"]},
        "coverage_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "metrics": {"type": "object"},
        "confidence": {"enum": ["high", "medium", "low", "ND"]},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceId"}},
        "recommendation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^R-[TBCSOM][0-9]{2}-[0-9]{3,}$"}},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "factor_id", "source_code", "artifact_id", "artifact_sha256", "locator", "method_id", "method_fingerprint", "grain", "numerator", "denominator", "observed_value", "examples", "confidence", "limitations"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/evidenceId"},
        "factor_id": {"$ref": "#/$defs/factorId"},
        "source_code": {"$ref": "#/$defs/sourceCode"},
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "locator": {"type": "string", "minLength": 1},
        "method_id": {"type": "string", "pattern": "^geo_factor_[tbcsom][0-9]{2}_v1$"},
        "method_fingerprint": {"$ref": "#/$defs/sha256"},
        "grain": {"type": "string", "minLength": 1},
        "numerator": {"type": ["integer", "number", "null"], "minimum": 0},
        "denominator": {"type": ["integer", "number", "null"], "minimum": 0},
        "observed_value": {},
        "examples": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1}},
        "confidence": {"enum": ["high", "medium", "low"]},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "factor_id", "statement", "evidence_ids", "root_cause_group"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^F-[TBCSOM][0-9]{2}-[0-9]{3,}$"},
        "factor_id": {"$ref": "#/$defs/factorId"},
        "statement": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceId"}},
        "root_cause_group": {"type": "string", "minLength": 1}
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendation_id", "factor_ids", "root_cause_key", "problem", "why_important", "action", "expected_effect", "effort", "risk", "validation_method", "evidence_ids"],
      "properties": {
        "recommendation_id": {"type": "string", "pattern": "^R-[TBCSOM][0-9]{2}-[0-9]{3,}$"},
        "factor_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/factorId"}},
        "root_cause_key": {"type": "string", "minLength": 1},
        "problem": {"type": "string", "minLength": 1},
        "why_important": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "expected_effect": {"type": "string", "minLength": 1},
        "effort": {"enum": ["low", "medium", "high"]},
        "risk": {"enum": ["low", "medium", "high"]},
        "validation_method": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceId"}}
      }
    }
  }
}
