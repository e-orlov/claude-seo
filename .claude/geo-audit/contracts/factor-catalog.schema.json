{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/e-orlov/claude-seo/.claude/geo-audit/contracts/factor-catalog.schema.json",
  "title": "GEO canonical factor catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "catalog_fingerprint", "factor_count", "block_count", "block_distribution", "scoring_policy_version", "scoring_policy_fingerprint", "factors"],
  "properties": {
    "catalog_version": {"const": "1.0.0"},
    "catalog_fingerprint": {"$ref": "#/$defs/sha256"},
    "factor_count": {"const": 129},
    "block_count": {"const": 6},
    "block_distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["T", "B", "C", "S", "O", "M"],
      "properties": {"T": {"const": 24}, "B": {"const": 26}, "C": {"const": 27}, "S": {"const": 20}, "O": {"const": 15}, "M": {"const": 17}}
    },
    "scoring_policy_version": {"const": "1.0.0"},
    "scoring_policy_fingerprint": {"const": "77da1451409845f6ba53d97f90071c92a4b26cc248f8d6b2bbc5634aaebe89ed"},
    "factors": {"type": "array", "minItems": 129, "maxItems": 129, "items": {"$ref": "#/$defs/factor"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nonEmptyString": {"type": "string", "minLength": 1},
    "factorId": {"type": "string", "pattern": "^(T|B|C|S|O|M)[0-9]{2}$"},
    "sourceCode": {"enum": ["SF", "RAW", "REN", "PSI", "GSC-SA", "GSC-UI", "GSC-GAI", "AH-BL", "AH-RD", "AH-BB", "SX-M", "SX-O", "SX-C", "SX-P", "SX-PC", "SX-S", "SX-SENT", "DJ"]},
    "factor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factor_id", "block_id", "ordinal", "label", "definition", "coverage_statement", "primary_sources", "analysis_method_id", "method_family", "measurement_universe", "applicability_rule", "canonical_metrics", "measurement_definition", "coverage_gate", "evidence_contract", "scoring_rule_ref", "dependency_role", "dependency_parents", "root_cause_group", "cluster_applicable", "limitations"],
      "properties": {
        "factor_id": {"$ref": "#/$defs/factorId"},
        "block_id": {"enum": ["T", "B", "C", "S", "O", "M"]},
        "ordinal": {"type": "integer", "minimum": 1},
        "label": {"$ref": "#/$defs/nonEmptyString"},
        "definition": {"$ref": "#/$defs/nonEmptyString"},
        "coverage_statement": {"$ref": "#/$defs/nonEmptyString"},
        "primary_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sourceCode"}},
        "analysis_method_id": {"type": "string", "pattern": "^geo_factor_[tbcsom][0-9]{2}_v1$"},
        "method_family": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "measurement_universe": {"$ref": "#/$defs/nonEmptyString"},
        "applicability_rule": {"type": "object", "minProperties": 1},
        "canonical_metrics": {"type": "array", "minItems": 1, "items": {"type": "object", "minProperties": 1}},
        "measurement_definition": {"type": "object", "minProperties": 1},
        "coverage_gate": {"type": "object", "minProperties": 1},
        "evidence_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_artifact_sha256_required", "method_and_filter_fingerprint_required", "grain_required", "numerator_denominator_required", "minimum_representative_examples_for_red_or_yellow", "examples_must_belong_to_affected_set"],
          "properties": {
            "source_artifact_sha256_required": {"const": true},
            "method_and_filter_fingerprint_required": {"const": true},
            "grain_required": {"const": true},
            "numerator_denominator_required": {"const": true},
            "minimum_representative_examples_for_red_or_yellow": {"const": 1},
            "examples_must_belong_to_affected_set": {"const": true}
          }
        },
        "scoring_rule_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["factor_id", "policy_version", "policy_fingerprint"],
          "properties": {
            "factor_id": {"$ref": "#/$defs/factorId"},
            "policy_version": {"const": "1.0.0"},
            "policy_fingerprint": {"const": "77da1451409845f6ba53d97f90071c92a4b26cc248f8d6b2bbc5634aaebe89ed"}
          }
        },
        "dependency_role": {"enum": ["eligibility_gate", "direct_observed_outcome", "supporting_driver"]},
        "dependency_parents": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/factorId"}},
        "root_cause_group": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "cluster_applicable": {"type": "boolean"},
        "limitations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}}
      }
    }
  }
}
