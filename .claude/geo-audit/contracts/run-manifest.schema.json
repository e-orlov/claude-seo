{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/e-orlov/claude-seo/.claude/geo-audit/contracts/run-manifest.schema.json",
  "title": "Resumable GEO audit run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_type", "schema_version", "run_id", "revision", "state",
    "created_at", "updated_at", "config", "contract", "source_set_sha256",
    "source_checks", "artifacts", "mcp_probes", "sistrix_cost_plan",
    "record_gaps", "blocking_actions", "events", "manifest_sha256"
  ],
  "properties": {
    "package_type": {"const": "geo_run_manifest"},
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^geo-[a-z0-9-]+-[0-9]{4}-[0-9]{2}-[0-9]{2}-r[1-9][0-9]*$"},
    "revision": {"type": "integer", "minimum": 1},
    "state": {"enum": [
      "CREATED", "PREFLIGHT", "WAITING_FOR_CONFIG", "WAITING_FOR_INPUTS",
      "READY", "READY_WITH_GAPS", "COLLECTING", "STAGED", "CLUSTERING",
      "WAITING_FOR_CLUSTER_CONFIRMATION", "ANALYZING", "VALIDATING",
      "ANALYSIS_COMPLETE", "ANALYSIS_COMPLETE_WITH_GAPS", "BLOCKED", "FAILED"
    ]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "original_domain", "normalized_domain"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "original_domain": {"type": "string", "minLength": 1},
        "normalized_domain": {"type": "string", "minLength": 1}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_catalog_version", "source_catalog_fingerprint",
        "factor_catalog_version", "factor_catalog_fingerprint",
        "policy_version", "policy_fingerprint"
      ],
      "properties": {
        "source_catalog_version": {"const": "1.0.0"},
        "source_catalog_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "factor_catalog_version": {"const": "1.0.0"},
        "factor_catalog_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "policy_version": {"const": "1.0.0"},
        "policy_fingerprint": {"const": "77da1451409845f6ba53d97f90071c92a4b26cc248f8d6b2bbc5634aaebe89ed"}
      }
    },
    "source_set_sha256": {
      "oneOf": [
        {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        {"type": "null"}
      ]
    },
    "source_checks": {"type": "array", "maxItems": 18, "items": {"$ref": "#/$defs/sourceCheck"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "mcp_probes": {"type": "array", "items": {"$ref": "#/$defs/probe"}},
    "sistrix_cost_plan": {"type": ["object", "null"]},
    "record_gaps": {"type": "array", "items": {"type": "object"}},
    "blocking_actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "sourceCode": {"enum": ["SF", "RAW", "REN", "PSI", "GSC-SA", "GSC-UI", "GSC-GAI", "AH-BL", "AH-RD", "AH-BB", "SX-M", "SX-O", "SX-C", "SX-P", "SX-PC", "SX-S", "SX-SENT", "DJ"]},
    "sourceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_code", "access_status", "data_status", "scope_status", "freshness_status", "blocking", "affected_factors", "action", "details"],
      "properties": {
        "source_code": {"$ref": "#/$defs/sourceCode"},
        "access_status": {"enum": ["pass", "fail", "auth_required"]},
        "data_status": {"enum": ["present", "missing", "partial", "malformed"]},
        "scope_status": {"enum": ["match", "mismatch", "unknown"]},
        "freshness_status": {"enum": ["current", "stale", "unknown"]},
        "blocking": {"type": "boolean"},
        "affected_factors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(T|B|C|S|O|M)[0-9]{2}$"}},
        "action": {"type": ["string", "null"]},
        "details": {"type": "object"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "source_code", "path_or_locator", "sha256", "byte_size", "schema_fingerprint", "snapshot_at", "record_count", "valid_empty", "adapter_version"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "source_code": {"$ref": "#/$defs/sourceCode"},
        "path_or_locator": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "byte_size": {"type": "integer", "minimum": 0},
        "schema_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "snapshot_at": {"type": "string", "format": "date-time"},
        "record_count": {"type": "integer", "minimum": 0},
        "valid_empty": {"type": "boolean"},
        "adapter_version": {"type": "integer", "minimum": 1}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server", "package_path", "package_sha256", "adapter_version", "captured_at", "verified"],
      "properties": {
        "server": {"enum": ["screaming_frog", "sistrix"]},
        "package_path": {"type": "string", "minLength": 1},
        "package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "adapter_version": {"type": "integer", "minimum": 1},
        "captured_at": {"type": "string", "format": "date-time"},
        "verified": {"const": true}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "from_state", "to_state", "event_type", "created_at", "payload"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "from_state": {"type": ["string", "null"]},
        "to_state": {"type": "string", "minLength": 1},
        "event_type": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "payload": {"type": "object"}
      }
    }
  }
}
