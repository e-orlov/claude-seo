{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/e-orlov/claude-seo/.claude/geo-audit/contracts/mcp-probe.schema.json",
  "title": "Verified GEO MCP preflight capture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_type", "schema_version", "server", "adapter_version",
    "captured_at", "scope", "calls", "source_results", "cost_plan",
    "verification", "package_sha256"
  ],
  "properties": {
    "package_type": {"const": "geo_mcp_probe"},
    "schema_version": {"const": 1},
    "server": {"enum": ["screaming_frog", "sistrix"]},
    "adapter_version": {"type": "integer", "minimum": 1},
    "captured_at": {"type": "string", "format": "date-time"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "country", "models"],
      "properties": {
        "domain": {"type": "string", "minLength": 1},
        "country": {"type": ["string", "null"]},
        "models": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "calls": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/call"}},
    "source_results": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/sourceResult"}},
    "cost_plan": {"type": ["object", "null"]},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "verified_at", "checks_run", "failures"],
      "properties": {
        "passed": {"const": true},
        "verified_at": {"type": "string", "format": "date-time"},
        "checks_run": {"type": "integer", "minimum": 1},
        "failures": {"type": "array", "maxItems": 0}
      }
    },
    "package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_id", "callable_name", "request_parameters", "response_path", "response_sha256", "response_schema_fingerprint", "recorded_at"],
      "properties": {
        "call_id": {"type": "string", "minLength": 1},
        "callable_name": {"type": "string", "minLength": 1},
        "request_parameters": {"type": "object"},
        "response_path": {"type": "string", "minLength": 1},
        "response_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "response_schema_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "sourceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_code", "call_ids", "access_status", "data_status", "scope_status", "freshness_status", "snapshot_at", "record_count", "valid_empty", "semantic_checks", "assertions", "details", "limitations"],
      "properties": {
        "source_code": {"type": "string", "minLength": 1},
        "call_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "access_status": {"const": "pass"},
        "data_status": {"enum": ["present", "partial"]},
        "scope_status": {"const": "match"},
        "freshness_status": {"enum": ["current", "stale", "unknown"]},
        "snapshot_at": {"type": "string", "format": "date-time"},
        "record_count": {"type": "integer", "minimum": 0},
        "valid_empty": {"type": "boolean"},
        "semantic_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "assertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assertion"}},
        "details": {"type": "object"},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_id", "proof_role", "locator_type", "locator", "operator", "expected", "description"],
      "properties": {
        "call_id": {"type": "string", "minLength": 1},
        "proof_role": {"enum": ["schema", "scope_domain", "scope_country", "scope_model", "snapshot", "record_count"]},
        "locator_type": {"enum": ["json_pointer", "xml_path", "text_contains", "request_parameter"]},
        "locator": {"type": "string", "minLength": 1},
        "operator": {"enum": ["exists", "nonempty", "equals", "contains", "gte", "length_equals"]},
        "expected": {},
        "description": {"type": "string", "minLength": 1}
      }
    }
  }
}
