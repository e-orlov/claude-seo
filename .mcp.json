{
  "mcpServers": {
    "chrome-devtools": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "chrome-devtools-mcp@latest"]
    },
    "duckdb": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2",
        "mcp-server-duckdb",
        "--db-path",
        "${USERPROFILE}\\duckdb-data\\main.duckdb"
      ]
    }
  }
}
